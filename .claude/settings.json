{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/irons/agentgate_team/agentgate/.claude/hooks/enforce-isolation.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/irons/agentgate_team/agentgate/.claude/hooks/role-guardian.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/irons/agentgate_team/agentgate/.claude/hooks/block-role-subagent.sh"
          }
        ]
      }
    ]
  }
}
