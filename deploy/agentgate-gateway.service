[Unit]
Description=AgentGate Channel Gateway
After=network.target

[Service]
Type=simple
User=irons
ExecStart=/home/irons/.local/bin/agentgate-gateway --config /home/irons/.agentgate/gateway/config.yaml
Restart=always
RestartSec=3
# NOTE: No HTTPS_PROXY here. Telegram proxy is configured per-bot in config.yaml.
# Setting HTTPS_PROXY globally would force Feishu (domestic) through the proxy too.

[Install]
WantedBy=multi-user.target
